# Production static SPA image (nginx). Dev Compose still uses the Vite Dockerfile.
FROM node:20-alpine AS build
WORKDIR /app
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web .
ARG VITE_API_URL=/api
ARG VITE_STATIC_URL=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_STATIC_URL=$VITE_STATIC_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
ENV API_HOST=crx-api
ENV API_PORT=8000
# Directory whose uploads/ subtree holds the content-addressed blobs. In
# production this is the shared crx-api-data volume mounted read-only; nginx
# serves /uploads/<key> from it directly instead of proxying the API.
ENV BLOB_ROOT=/app/data
EXPOSE 80
