# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.ruff_cache/
*.egg-info/
.eggs/
dist/
build/

# Node
**/node_modules/
apps/web/dist/

# Runtime data (local DB, uploads, OCR cache, conversion output, corpora)
data/db/*
!data/db/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/output/*
!data/output/.gitkeep
data/ocr_cache/*
!data/ocr_cache/.gitkeep
# Review snapshots (tools/snapshot_review.py); CI keeps them as workflow artifacts.
data/backups/
# --out targets people pass to snapshot_review.py from the repo root.
prod-review-snapshot.json/
prod-verify.json/
data/corpora/*
!data/corpora/README.md

# Generated by `make seed-fixtures` from tools/fixture_corpus.py — byte-identical on
# every machine, so the generator is the source of truth rather than its output.
data/fixtures/

# Output of `npm run smoke` (apps/web/scripts/visual_smoke.mjs).
apps/web/scripts/visual_shots/
apps/web/scripts/visual_smoke_report.json

# Seed corpus (built locally by `make seed-archive`, baked into Docker image).
# Too large for git (~500MB+ with PDFs); built before `make deploy-prod`.
data/seed/*
!data/seed/.gitkeep
!data/seed/README.md
!data/seed/ordinance/
data/seed/ordinance/*
!data/seed/ordinance/.gitkeep
!data/seed/acts/
data/seed/acts/*
!data/seed/acts/.gitkeep
apps/api/backend/data/*
!apps/api/backend/data/.gitkeep
apps/api/backend/uploads/*
!apps/api/backend/uploads/.gitkeep

# Seed blobs (never ship multi-GB corpora)
**/seed_uploads/
**/seed_data/
**/.ocrcache/

# Env / secrets
.env
.env.local

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Ad-hoc probes
apps/web/probe*.mjs
apps/web/repro.mjs
apps/web/sweep.mjs

# Exported session transcripts, which land in the repo root
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
