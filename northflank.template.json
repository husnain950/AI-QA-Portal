{
  "apiVersion": "v1.2",
  "name": "fbr-qa-staging",
  "description": "Redeploy the FBR Corpus QA portal (api, worker, web) into the existing free-plan project qa-pdf-portal (branch args.branch), against a managed PostgreSQL addon, with the crx-api persistent volume at /app/data holding the content-addressed blobs.",
  "arguments": {
    "branch": "main",
    "plan": "nf-compute-10",
    "projectId": "qa-pdf-portal",
    "postgresPlan": "nf-compute-10"
  },
  "options": {
    "autorun": false,
    "concurrencyPolicy": "queue"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "context": {
        "projectId": "${args.projectId}"
      },
      "steps": [
        {
          "kind": "Addon",
          "ref": "database",
          "spec": {
            "name": "crx-postgres",
            "type": "postgres",
            "version": "17",
            "billing": {
              "deploymentPlan": "${args.postgresPlan}",
              "storage": 8192,
              "replicas": 1
            },
            "tlsEnabled": true,
            "externalAccessEnabled": false
          }
        },
        {
          "kind": "Volume",
          "ref": "api-data",
          "updateMode": "patch",
          "spec": {
            "name": "crx-api-data",
            "mounts": [
              {
                "volumeMountPath": "",
                "containerMountPath": "/app/data"
              }
            ],
            "spec": {
              "storageSize": 6144,
              "storageClassName": "nvme",
              "accessMode": "ReadWriteOnce"
            },
            "attachedObjects": [
              {
                "id": "crx-api",
                "type": "service"
              },
              {
                "id": "crx-worker",
                "type": "service"
              }
            ]
          }
        },
        {
          "kind": "CombinedService",
          "ref": "api",
          "spec": {
            "name": "crx-api",
            "billing": {
              "deploymentPlan": "${args.plan}",
              "buildPlan": "nf-compute-400-16"
            },
            "vcsData": {
              "projectType": "github",
              "projectUrl": "https://github.com/husnain950/AI-QA-Portal",
              "projectBranch": "${args.branch}",
              "accountLogin": "husnain950"
            },
            "buildSettings": {
              "dockerfile": {
                "buildEngine": "kaniko",
                "dockerFilePath": "/apps/api/Dockerfile",
                "dockerWorkDir": "/",
                "useCache": false
              }
            },
            "deployment": {
              "instances": 1,
              "docker": {
                "configType": "default"
              },
              "addonDependencies": [
                {
                  "addonId": "crx-postgres",
                  "envMapping": [
                    {
                      "key": "POSTGRES_URI",
                      "envKey": "DATABASE_URL"
                    }
                  ]
                }
              ]
            },
            "runtimeEnvironment": {
              "STORAGE_BACKEND": "filesystem",
              "UPLOAD_DIR": "/app/data/uploads",
              "CORPUS_ORDINANCE": "/data/corpus/ordinance",
              "CORPUS_ACTS": "/data/corpus/acts",
              "PYTHONPATH": "/app",
              "PYTHONUNBUFFERED": "1",
              "CSP_ENFORCE": "1"
            },
            "buildArguments": {},
            "ports": [
              {
                "name": "p01",
                "internalPort": 8000,
                "protocol": "HTTP",
                "public": false
              }
            ]
          }
        },
        {
          "kind": "CombinedService",
          "ref": "worker",
          "spec": {
            "name": "crx-worker",
            "billing": {
              "deploymentPlan": "${args.plan}",
              "buildPlan": "nf-compute-400-16"
            },
            "vcsData": {
              "projectType": "github",
              "projectUrl": "https://github.com/husnain950/AI-QA-Portal",
              "projectBranch": "${args.branch}",
              "accountLogin": "husnain950"
            },
            "buildSettings": {
              "dockerfile": {
                "buildEngine": "kaniko",
                "dockerFilePath": "/apps/api/Dockerfile",
                "dockerWorkDir": "/",
                "useCache": false
              }
            },
            "deployment": {
              "instances": 1,
              "docker": {
                "configType": "customCommand",
                "customCommand": "python -m backend.worker"
              },
              "addonDependencies": [
                {
                  "addonId": "crx-postgres",
                  "envMapping": [
                    {
                      "key": "POSTGRES_URI",
                      "envKey": "DATABASE_URL"
                    }
                  ]
                }
              ]
            },
            "runtimeEnvironment": {
              "STORAGE_BACKEND": "filesystem",
              "UPLOAD_DIR": "/app/data/uploads",
              "CORPUS_ORDINANCE": "/data/corpus/ordinance",
              "CORPUS_ACTS": "/data/corpus/acts",
              "PYTHONPATH": "/app",
              "PYTHONUNBUFFERED": "1",
              "CSP_ENFORCE": "1"
            },
            "buildArguments": {},
            "ports": []
          }
        },
        {
          "kind": "CombinedService",
          "ref": "web",
          "spec": {
            "name": "crx-web",
            "billing": {
              "deploymentPlan": "${args.plan}",
              "buildPlan": "nf-compute-400-16"
            },
            "vcsData": {
              "projectType": "github",
              "projectUrl": "https://github.com/husnain950/AI-QA-Portal",
              "projectBranch": "${args.branch}",
              "accountLogin": "husnain950"
            },
            "buildSettings": {
              "dockerfile": {
                "buildEngine": "kaniko",
                "dockerFilePath": "/apps/web/Dockerfile.prod",
                "dockerWorkDir": "/",
                "useCache": false
              }
            },
            "buildArguments": {
              "VITE_API_URL": "/api",
              "VITE_STATIC_URL": ""
            },
            "deployment": {
              "instances": 1,
              "docker": {
                "configType": "default"
              }
            },
            "runtimeEnvironment": {
              "API_HOST": "crx-api",
              "API_PORT": "8000"
            },
            "ports": [
              {
                "name": "p01",
                "internalPort": 80,
                "protocol": "HTTP",
                "public": true
              }
            ]
          }
        }
      ]
    }
  }
}
