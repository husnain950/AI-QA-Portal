# PostgreSQL 17 and content-addressed storage. Compose defaults work as-is.
DATABASE_URL=postgresql+psycopg://crx:crx@localhost:5432/crx
POSTGRES_DB=crx
POSTGRES_USER=crx
POSTGRES_PASSWORD=crx
POSTGRES_PORT=5432

STORAGE_BACKEND=s3
UPLOAD_DIR=./data/uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=crx-blobs
S3_ACCESS_KEY_ID=crx-minio
S3_SECRET_ACCESS_KEY=crx-minio-development
S3_REGION=us-east-1
MINIO_ROOT_USER=crx-minio
MINIO_ROOT_PASSWORD=crx-minio-development
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# CORS: comma-separated origins allowed by the API. Defaults to localhost dev
# origins when unset. In production behind the nginx reverse proxy on crx-web,
# the browser never makes cross-origin requests, so this can stay empty.
ALLOWED_ORIGINS=

# Corpus roots inside this repo (vendored under data/corpora/).
# Host-local paths for `make sync` / Compose. Do not inject these into a
# production container — the API image already sets /data/corpus/... and
# /seed/corpus/..., and `make deploy-prod` strips these keys from --env-file.
# Ordinance: output/*.json + "Income Tax Ordinance, 2001"/ PDFs
CORPUS_ORDINANCE=./data/corpora/ordinance
# Acts: output/*.json + Acts/**
CORPUS_ACTS=./data/corpora/acts

# Optional OCR cache for acts_ingest
OCR_CACHE_DIR=./data/ocr_cache

# AI fix loop (OpenAI-compatible gateway). All three are required to enable
# the "AI Fix" action in the review portal; without them it returns 503.
# OPENPATHS_MODELS is a comma-separated allow-list shown as a dropdown in the
# review UI; the FIRST entry is the default.
OPENPATHS_API_KEY=
OPENPATHS_BASE_URL=https://openpaths.io/v1
OPENPATHS_MODELS=gpt-5.4-nano,glm-4.6v-flashx,or/qwen3.7-plus

# Optional: models on OTHER endpoints (self-hosted, Modal, ...) join the same
# dropdown. One JSON object, single line: id -> {base_url, model, env_key, extra}.
# "extra" is merged into every chat request payload for that model, e.g.:
# LLM_EXTRA_PROVIDERS={"kimi": {"base_url": "https://host/v1", "model": "endpoint-model-name", "env_key": "wk-...", "extra": {"reasoning_effort": "low"}}}
LLM_EXTRA_PROVIDERS=

# Northflank deploys (tools/northflank_deploy.py). Only needed for local runs:
# CI reads NORTHFLANK_API_TOKEN from a GitHub Actions repository secret, since
# .env is gitignored and never reaches the runner.
NORTHFLANK_API_TOKEN=
NORTHFLANK_PROJECT_ID=qa-pdf-portal
NORTHFLANK_SERVICES=crx-api,crx-web
# Set only if your token is scoped to a team rather than a personal account.
NORTHFLANK_TEAM_ID=

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
VITE_STATIC_URL=http://localhost:8000

# Compose published ports
API_PORT=8000
WEB_PORT=5173
