# PostgreSQL 17 and content-addressed storage. Compose defaults work as-is.
DATABASE_URL=postgresql+psycopg://crx:crx@localhost:5432/crx
POSTGRES_DB=crx
POSTGRES_USER=crx
POSTGRES_PASSWORD=crx
POSTGRES_PORT=5432

# Blob storage. Empty = local disk under UPLOAD_DIR (the default, and what
# production runs — the web container serves /uploads straight from the blob
# volume). Set s3 only to exercise the MinIO/S3 path in Compose.
STORAGE_BACKEND=
UPLOAD_DIR=./data/uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=crx-blobs
S3_ACCESS_KEY_ID=crx-minio
S3_SECRET_ACCESS_KEY=crx-minio-development
S3_REGION=us-east-1
MINIO_ROOT_USER=crx-minio
MINIO_ROOT_PASSWORD=crx-minio-development
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Authentication. The first admin is created from these on a database with no users
# at all; after that, accounts are managed with `python -m backend.manage_users`.
# Passwords must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Session lifetime in hours (default 12).
SESSION_HOURS=12
# Set to 1 ONLY for plain-http local development: it drops Secure from the session
# cookie. Leave empty in production or the cookie rides a downgraded request.
INSECURE_COOKIES=
# Shared token for GET /api/v2/metrics, so a Prometheus scraper needs no session.
# Every other operator endpoint requires an admin session.
METRICS_TOKEN=
# Set to 1 to enforce the CSP instead of only reporting violations.
CSP_ENFORCE=
# Set to "off" to disable IP rate limiting (tests and local development only).
RATE_LIMITS=

# CORS: comma-separated origins allowed by the API. Defaults to localhost dev
# origins when unset. In production behind the nginx reverse proxy on crx-web,
# the browser never makes cross-origin requests, so this can stay empty.
ALLOWED_ORIGINS=

# Corpus roots inside this repo (vendored under data/corpora/).
# Host-local paths for `make sync` / Compose. Do not inject these into a
# production container — the API image already sets /data/corpus/... and
# /seed/corpus/..., and `make deploy-prod` strips these keys from --env-file.
# Ordinance: output/*.json + "Income Tax Ordinance, 2001"/ PDFs
CORPUS_ORDINANCE=./data/corpora/ordinance
# Acts: output/*.json + Acts/**
CORPUS_ACTS=./data/corpora/acts
# Rules: output/*.json + Rules/** (statutory instruments; see corpus_registry)
CORPUS_RULES=./data/corpora/rules

# Optional: a corpus baked into the API image, loaded on first boot.
# `make seed-archive` populates data/seed/; the image copies it to /seed/corpus.
# SEED_CORPUS_ORDINANCE=/seed/corpus/ordinance
# SEED_CORPUS_ACTS=/seed/corpus/acts
# SEED_CORPUS_RULES=/seed/corpus/rules

# Optional OCR cache for the acts/rules pipelines ("" disables it).
# Defaults to packages/.ocrcache when unset.
ACTS_OCR_CACHE=./data/ocr_cache

# AI fix loop (OpenAI-compatible gateway). API key + base URL enable the
# "AI Fix" action; without them it returns 503. The review UI dropdown is
# filled from GET {OPENPATHS_BASE_URL}/models (top chat models for PDF→JSON
# fixing, with pricing + vision flags). OPENPATHS_MODELS is an optional
# comma-separated prefix; those ids are shown first, then the auto top-10
# fills remaining slots. OPENPATHS_MODEL is the legacy single-model form.
OPENPATHS_API_KEY=
OPENPATHS_BASE_URL=https://openpaths.io/v1
OPENPATHS_MODELS=

# Optional: models on OTHER endpoints (self-hosted, Modal, ...) join the same
# dropdown. One JSON object, single line: id -> {base_url, model, env_key, extra}.
# Optional keys: vision (bool), label, input_price_per_1m, output_price_per_1m.
# "extra" is merged into every chat request payload for that model, e.g.:
# LLM_EXTRA_PROVIDERS={"kimi": {"base_url": "https://host/v1", "model": "endpoint-model-name", "env_key": "wk-...", "vision": true, "extra": {"reasoning_effort": "low"}}}
LLM_EXTRA_PROVIDERS=

# Northflank deploys (tools/northflank_deploy.py). Only needed for local runs:
# CI reads NORTHFLANK_API_TOKEN from a GitHub Actions repository secret, since
# .env is gitignored and never reaches the runner.
NORTHFLANK_API_TOKEN=
NORTHFLANK_PROJECT_ID=qa-pdf-portal
NORTHFLANK_SERVICES=crx-api,crx-web
# Set only if your token is scoped to a team rather than a personal account.
NORTHFLANK_TEAM_ID=

# Frontend (Vite). Same-origin /api so the dev proxy and prod nginx both
# forward to the API. Do not point this at http://localhost:8000 — a remote
# browser (qa.fbrcms.edly.io) would then wait on its own machine until timeout.
VITE_API_URL=/api
VITE_STATIC_URL=

# Compose published ports
API_PORT=8000
WEB_PORT=5173
